# Native build outputs
# This project uses Expo's continuous native generation (CNG): the android/
# and ios/ folders are NOT committed and are regenerated by `expo prebuild`
# on every EAS Build or local run. Treat them as build outputs, not source.
# All native config flows through app.json and config plugins.
/android
/ios
*.keystore
!debug.keystore
keystore.properties
.keystore-backup/

# EAS / Expo build artifacts
build-artifacts/
releases/
*.apk
*.aab
*.ipa

# Bundler / Cocoapods
ios/Podfile.lock.tmp

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# Cursor / AI tooling caches (keep settings tracked)
.cursor/

# Legacy Flutter reference app — keep locally for porting; never push to GitHub.
# RN runtime does not import this folder (see docs/flutter-code-local-reference.md).
src/flutter-code/

# Note: google-services.json and GoogleService-Info.plist ARE committed to
# this repo. Per Firebase docs, those files don't contain private secrets —
# they identify the Firebase project + bundle ID and end up bundled into
# every APK/IPA install. Keeping them in git lets EAS Build pick them up
# automatically. The actual secret you must protect is the APNs Auth Key
# (.p8 from Apple Developer Portal). Don't commit that.
*.p8
